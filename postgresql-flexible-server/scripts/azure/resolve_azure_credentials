#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# resolve_azure_credentials — Workflow step. Resolves the Azure identity for
# this action and exports ARM_SUBSCRIPTION_ID / ARM_CLIENT_ID / ARM_TENANT_ID
# so every later step (including tofu) inherits them.
#
# Runs FIRST in every Azure-touching workflow. The workflow YAML must declare
# those three names as output:environment or the engine will not propagate them.
#
# This step NEVER fails for lack of credentials: when nothing resolves it
# no-ops and Terraform falls back to the agent's own identity (Managed
# Identity / Workload Identity), which is also how local "az login" testing
# works. It only fails on a malformed context.
#
# ARM_CLIENT_SECRET is resolved and exported here too, from the provider or the
# environment — never from values.yaml, which is committed configuration.
#
# An earlier version of this script skipped the secret, on the premise that
# "the cloud-providers provider never exposes it". That premise was wrong:
# tofu-modules' nullplatform/cloud/azure/cloud writes client_secret into
# .authentication (its precondition requires all four credentials together),
# and nullplatform/agent injects AZURE_CLIENT_SECRET into the pod. The result
# was a half-used provider — client_id and tenant_id applied, no secret, and
# terraform silently falling back to managed identity.
#
# Propagating it as a step output is the established pattern: the reference
# aws-s3-bucket service declares AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN
# the same way. The value is never echoed.
#
# Requires: np CLI, jq. Expects: CONTEXT, VALUES (both engine-injected).
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/resolve_azure_credentials_lib"

# Each script needs its own copy — shell functions do not carry across steps.
yaml_value() {
  local key="$1" default="$2" file="$3"
  local raw val
  raw=$(grep "^${key}:" "$file" 2>/dev/null | head -1) || true
  if [ -z "$raw" ]; then
    echo "$default"
    return 0
  fi

  val="${raw#*:}"
  # Trim leading whitespace.
  val="${val#"${val%%[![:space:]]*}"}"

  # A quoted value ends at its closing quote; anything after it (typically an
  # inline comment) is not part of the value. An unquoted value ends at the
  # first "#".
  #
  # The previous version stripped only a leading and a trailing quote, so
  #   tfstate_resource_group: ""   # empty = resource_group_name
  # came back as the non-empty string '"   # empty = resource_group_name',
  # which then beat every other resolution tier and was written verbatim into
  # backend.hcl. HCL read it as an empty string plus a comment, and tofu hung
  # resolving a storage account with no resource group.
  case "$val" in
    '"'*) val="${val#\"}"; val="${val%%\"*}" ;;
    "'"*) val="${val#\'}"; val="${val%%\'*}" ;;
    *)
      val="${val%%#*}"
      val="${val%"${val##*[![:space:]]}"}"
      ;;
  esac

  echo "${val:-$default}"
}

V_SUB=""
V_CLIENT=""
V_TENANT=""

if [ -n "${VALUES:-}" ] && [ -f "${VALUES}" ]; then
  V_SUB=$(yaml_value "subscription_id" "" "$VALUES")
  V_CLIENT=$(yaml_value "client_id" "" "$VALUES")
  V_TENANT=$(yaml_value "tenant_id" "" "$VALUES")
fi

# Full NRN as-is — resolution walks UP the hierarchy, so do not strip it.
# `|| NRN=""` matters: this is a bare assignment under `set -euo pipefail`, so a
# non-JSON CONTEXT makes jq exit non-zero, pipefail propagates it, and the script
# dies with jq's raw exit code and no message — never reaching the diagnostic below.
NRN=$(echo "${CONTEXT:-}" | jq -r '.service.nrn // .link.scope.nrn // .entity_nrn // ""' 2>/dev/null) || NRN=""

if [ -z "$NRN" ]; then
  echo "ERROR: could not derive an NRN from CONTEXT (.service.nrn / .link.scope.nrn / .entity_nrn)" >&2
  exit 1
fi

# Dimensions as key:value,key:value so np resolves the most specific provider.
DIMENSIONS=$(echo "${CONTEXT:-}" | jq -r '
  if (.service.dimensions | type) == "object" and ((.service.dimensions | length) > 0)
  then [ .service.dimensions | to_entries[] | "\(.key):\(.value)" ] | join(",")
  else empty end' 2>/dev/null)

# NOTE: --limit is incompatible with --categories (np rejects it). Do not add it.
# shellcheck disable=SC2086
PROVIDER_ATTRS=$(np provider list \
  --nrn "$NRN" \
  --categories cloud-providers \
  ${DIMENSIONS:+--dimensions "$DIMENSIONS"} \
  --format json 2>/dev/null \
  | jq -c '(.results // [])[0].attributes // {}' 2>/dev/null) || PROVIDER_ATTRS='{}'

# Explicit two-line default: "${VAR:-\{\}}" does NOT yield {} — inside double
# quotes the backslashes are literal, so it produces the four-character string \{\}.
if [ -z "$PROVIDER_ATTRS" ]; then
  PROVIDER_ATTRS='{}'
fi

IFS="$NP_FS" read -r P_SUB P_CLIENT P_TENANT <<< "$(sp_from_provider "$PROVIDER_ATTRS")" || true
IFS="$NP_FS" read -r SUB CLIENT TENANT <<< "$(resolve_azure_credentials "$PROVIDER_ATTRS" "$V_SUB" "$V_CLIENT" "$V_TENANT")" || true
SECRET=$(resolve_client_secret "$PROVIDER_ATTRS")

echo "Resolving Azure identity for NRN=${NRN}${DIMENSIONS:+ dimensions=${DIMENSIONS}}"
echo "   subscription: $(credential_source "$V_SUB" "$P_SUB" "$(env_subscription_id)")"
echo "   client_id:    $(credential_source "$V_CLIENT" "$P_CLIENT" "$(env_client_id)")"
echo "   tenant_id:    $(credential_source "$V_TENANT" "$P_TENANT" "$(env_tenant_id)")"

if [ -z "$SUB" ] && [ -z "$CLIENT" ] && [ -z "$TENANT" ]; then
  echo "   ✅ no explicit credentials resolved — using agent-identity (Managed Identity / az login)"
else
  if [ -n "$CLIENT" ] && [ -z "$SECRET" ]; then
    echo "   ⚠️  client_id resolved but no client secret found in the provider or the environment." >&2
    echo "       Terraform will attempt managed identity instead of the service principal." >&2
  fi
  echo "   ✅ Azure identity resolved"
fi

export ARM_SUBSCRIPTION_ID="$SUB"
export ARM_CLIENT_ID="$CLIENT"
export ARM_TENANT_ID="$TENANT"
export ARM_CLIENT_SECRET="$SECRET"
