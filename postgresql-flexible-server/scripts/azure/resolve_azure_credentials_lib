#!/bin/bash
# Sourceable library of PURE helpers for Azure credential resolution.
# Makes NO np/az calls and has no source side effects — fully unit-testable.
#
# Requires (at call time): jq, bash >= 4.

# The packed-triple field separator is ASCII UNIT SEPARATOR (0x1f), NOT a tab.
# Bash treats space, tab and newline as "IFS whitespace" even when IFS is set to
# only one of them: leading and trailing runs are stripped and consecutive runs
# collapse into a single delimiter. With a tab separator, a provider that supplies
# subscription_id and tenant_id but no client_id yields "sub<TAB><TAB>tenant",
# which `IFS=$'\t' read -r a b c` parses as a="sub", b="tenant", c="" — the tenant
# value is cross-assigned into the client slot and exported as ARM_CLIENT_ID.
# 0x1f is not IFS whitespace, so empty leading and middle fields survive intact.
NP_FS=$(printf '\037')

# sp_from_provider <provider_attributes_json>
# Echoes "<subscription_id><US><client_id><US><tenant_id>" read from the provider's
# .authentication block. Any field the provider omits comes back empty. Never
# crashes on empty or malformed input.
sp_from_provider() {
  local json="${1:-}"

  if [ -z "$json" ]; then
    printf '%s%s' "$NP_FS" "$NP_FS"
    return 0
  fi

  local out
  out=$(printf '%s' "$json" | jq -r --arg us "$NP_FS" '
    [ (.authentication.subscription_id // ""),
      (.authentication.client_id // ""),
      (.authentication.tenant_id // "") ] | join($us)' 2>/dev/null) || out=""

  if [ -z "$out" ]; then
    printf '%s%s' "$NP_FS" "$NP_FS"
  else
    printf '%s' "$out"
  fi
}

# resolve_azure_credentials <provider_attributes_json> <values_sub> <values_client> <values_tenant>
# Echoes "<subscription_id><US><client_id><US><tenant_id>" (NP_FS/0x1f separated,
# NOT tab-separated — see the NP_FS comment above), resolving each field
# independently in this order:
#   1. values.yaml         — explicit, service-scoped operator configuration
#   2. provider            — platform configuration for this NRN + dimensions
#   3. ambient env         — ARM_*, then the AZURE_* names the nullplatform
#                            agent module actually injects into the pod
#   4. empty               — caller falls through to the agent's own identity
#
# values.yaml deliberately outranks the environment: the agent inherits every
# variable from its launching shell, so an ambient ARM_SUBSCRIPTION_ID would
# otherwise silently redirect this service to the wrong subscription.
resolve_azure_credentials() {
  local provider_json="${1:-}" v_sub="${2:-}" v_client="${3:-}" v_tenant="${4:-}"
  local p_sub="" p_client="" p_tenant=""

  IFS="$NP_FS" read -r p_sub p_client p_tenant <<< "$(sp_from_provider "$provider_json")" || true

  local sub client tenant
  sub="${v_sub:-${p_sub:-$(env_subscription_id)}}"
  client="${v_client:-${p_client:-$(env_client_id)}}"
  tenant="${v_tenant:-${p_tenant:-$(env_tenant_id)}}"

  printf '%s%s%s%s%s' "$sub" "$NP_FS" "$client" "$NP_FS" "$tenant"
}

# --- Ambient environment ----------------------------------------------------
# Two naming conventions reach the agent process, and only the second is
# actually produced by the platform:
#
#   ARM_*    terraform's own convention. Set by hand, or by a developer shell.
#   AZURE_*  what tofu-modules' nullplatform/agent module injects into the
#            agent pod for cloud_provider = "azure" (AZURE_SUBSCRIPTION_ID,
#            AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET, plus
#            RESOURCE_GROUP). Verified against tofu-modules v7.7.0.
#
# Reading only ARM_* — as this library originally did — meant a service running
# on a real nullplatform Azure agent picked up NOTHING from the environment the
# platform had already given it. ARM_* still wins when both are set, because it
# is the explicit, deliberate one.

env_subscription_id() { printf '%s' "${ARM_SUBSCRIPTION_ID:-${AZURE_SUBSCRIPTION_ID:-}}"; }
env_client_id()       { printf '%s' "${ARM_CLIENT_ID:-${AZURE_CLIENT_ID:-}}"; }
env_tenant_id()       { printf '%s' "${ARM_TENANT_ID:-${AZURE_TENANT_ID:-}}"; }
env_client_secret()   { printf '%s' "${ARM_CLIENT_SECRET:-${AZURE_CLIENT_SECRET:-}}"; }

# secret_from_provider <provider_attributes_json>
# Echoes .authentication.client_secret, or empty. Kept separate from
# sp_from_provider so the secret never travels in the same packed triple that
# gets logged, echoed and passed between workflow steps.
secret_from_provider() {
  local json="${1:-}"
  [ -z "$json" ] && return 0
  printf '%s' "$json" | jq -r '.authentication.client_secret // ""' 2>/dev/null || true
}

# resolve_client_secret <provider_attributes_json>
# Resolution order: provider -> ARM_CLIENT_SECRET -> AZURE_CLIENT_SECRET -> empty.
#
# There is deliberately NO values.yaml tier: values.yaml is committed
# configuration and must never hold a secret.
#
# Callers must resolve this at the point of use and never export it as a
# workflow step output — step outputs are declared in the workflow YAML and
# propagate through the engine, which is not a channel for a credential.
resolve_client_secret() {
  local provider_json="${1:-}"
  local from_provider
  from_provider=$(secret_from_provider "$provider_json")
  printf '%s' "${from_provider:-$(env_client_secret)}"
}

# credential_source <values_val> <provider_val> <env_val>
# Echoes which precedence branch supplied a value, for logging. Never echoes
# the value itself.
credential_source() {
  local v="${1:-}" p="${2:-}" e="${3:-}"

  if [ -n "$v" ]; then
    printf 'values.yaml'
  elif [ -n "$p" ]; then
    printf 'provider'
  elif [ -n "$e" ]; then
    printf 'environment'
  else
    printf 'agent-identity'
  fi
}
